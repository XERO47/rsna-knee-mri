# Data (downloaded separately via scripts/download_data.py / prepare_dataset.py)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
*.dcm
*.zip

# Models / checkpoints
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Large arrays / prediction dumps (cache shards, embeddings, gold predictions)
*.npy
*.npz
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle

# Per-arm dataset staging: everything under kaggle/<arm>/output|upload|
# *_upload|*_artifacts is generated by training runs and re-staged for Kaggle
# uploads, not source. dataset-metadata.json is Kaggle CLI boilerplate, not
# worth tracking either. kaggle_datasets/ mirrors the same staged bundles at
# the repo root.
kaggle/*/output/
kaggle/*/upload/
kaggle/*/*_upload/
kaggle/*/*_artifacts/
kaggle_datasets/
dataset-metadata.json

# Kaggle credentials
kaggle.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
.venv_web/
venv/
env/
.ipynb_checkpoints/

# Logs / experiment tracking
runs/
wandb/
logs/
*.log
roi_work/

# OS
.DS_Store
Thumbs.db

# Local tool config
.claude/

# generated extraction stage kernels
kaggle/extract-pilot/
kaggle/extract-full/
kaggle/extract-pilot-n2/
kaggle/extract-full-n2/
kaggle/labelaudit/sheets/
kaggle/extract-probe2/
kaggle/extract-probe3/
kaggle/extract-probe4/
kaggle/extract-probe5/
kaggle/extract-probe6/
kaggle/extract-probe7/
kaggle/extract-pilot/
